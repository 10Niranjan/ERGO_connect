# secrets / local env
.env
.env.*
!.env.example
*.pem
*.key

# personal Claude Code settings (shared agents in .claude/agents are committed)
.claude/settings.local.json

# build output & deps (per-project .gitignore files cover the rest)
node_modules/
target/
dist/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Git Bash crash dumps
*.stackdump

# Never commit database dumps, or the compiled form of a .bicepparam (az bicep build-params writes infra/staging.json
# with every secret read from the environment in plain text)
*.gpg
*.dump
*.part
/infra/*.json
