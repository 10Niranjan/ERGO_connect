{
  "role": { "name": "ergo-backend" },
  "sampling": {
    "percentage": 100,
    "overrides": [
      {
        "telemetryType": "request",
        "attributes": [{ "key": "url.path", "value": "/actuator/health.*", "matchType": "regexp" }],
        "percentage": 0
      },
      {
        "telemetryType": "request",
        "attributes": [{ "key": "code.function", "value": "refreshIfChanged", "matchType": "strict" }],
        "percentage": 0
      }
    ]
  },
  "instrumentation": {
    "logging": { "level": "WARN" }
  },
  "selfDiagnostics": { "destination": "console", "level": "warn" }
}
