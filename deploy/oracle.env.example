# Production .env for docker-compose.oracle.yml. Copy to .env on the VM, chmod 600, never commit it.
# Every blank value must be filled. Secrets: openssl rand -base64 36 (DB_*), openssl rand -base64 48 (JWT_SECRET).
DOMAIN=
# Commit sha of the images to run: one whose CI run is green (README "Production on Oracle", step 2)
IMAGE_TAG=
IMAGE_OWNER=varadyadav02
# Three different values. Admin = Postgres superuser (backups only); owner = Flyway; app = the running app.
# The DB_* values are applied only when the database is first created; changing them later needs ALTER ROLE too.
DB_ADMIN_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
JWT_SECRET=
# SMTP with STARTTLS (port 587). Required: the app will not start without it.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# First start only, then delete both lines and restart the backend.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# backup.sh: GPG key (id or email) the dumps are encrypted to; only its PUBLIC key is imported on the VM.
BACKUP_GPG_RECIPIENT=
# backup.sh: rclone destination for the off-machine copy, e.g. ergo-backups:ergo-backups (README step 5).
BACKUP_RCLONE_REMOTE=
# backup.sh: URL pinged after every successful backup (e.g. a healthchecks.io check that emails you when pings stop).
BACKUP_PING_URL=
