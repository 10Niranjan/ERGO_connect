# Production .env for docker-compose.micro-prod.yml (Micro VM + Neon). Copy to .env on the VM, chmod 600, never commit it.
# Every blank value must be filled. Secrets: openssl rand -base64 48 (JWT_SECRET).
# Public hostname, no scheme. A real domain pointed at a RESERVED public IP is the target: with dashed-IP.sslip.io, if the VM is
# reclaimed or recreated the IP (and name) can go to another Oracle tenant, who then holds a valid certificate for your hostname.
# sslip.io is acceptable only for a short pilot. Do not reuse the client demo's 130-210-58-133.sslip.io (dev profile, shared password).
DOMAIN=
# Commit sha of the images to run: one whose "Demo images" workflow run is green (CI tests + Trivy CVE scans).
IMAGE_TAG=
IMAGE_OWNER=varadyadav02
# Neon DIRECT (non-pooled) host of the ergo-prod project, database ergo_connect. Must be verify-full: sslmode=require does not
# check the server certificate, so anyone on the path could pose as Neon and capture the schema owner's password:
#   jdbc:postgresql://<ep-...>.ap-southeast-1.aws.neon.tech/ergo_connect?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory&channelBinding=require
DB_URL=
# Neon roles. owner = Flyway only; app = the running app (rows only, cannot drop tables or the audit trigger).
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
JWT_SECRET=
# SMTP with STARTTLS (port 587). Required: the app will not start without it.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# First start only, then delete both lines and restart the backend.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# backup.sh (nightly cron, see README "Interim production"): the GPG key the dumps are encrypted to (only its PUBLIC key is imported on the VM)
BACKUP_GPG_RECIPIENT=
# Off-site copy, either an Oracle Object Storage pre-authenticated request (write-only, one bucket, expires: renew it before then)
# https://objectstorage.<region>.oraclecloud.com/p/<token>/n/<namespace>/b/<bucket>/o/   (must end in /o/)
BACKUP_PAR_URL=
# or an rclone remote, e.g. ergo-backups:ergo-backups
BACKUP_RCLONE_REMOTE=
# Optional: URL pinged after every successful backup (e.g. a healthchecks.io check that emails you when pings stop)
BACKUP_PING_URL=
