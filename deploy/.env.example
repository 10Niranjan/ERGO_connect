# Copy to .env on the server (never commit .env). Generate secrets with:  openssl rand -base64 36
# Public hostname, no scheme. Free, no signup: dashed-IP.sslip.io, e.g. 130-61-5-9.sslip.io for IP 130.61.5.9 (or yourname.duckdns.org).
DOMAIN=130-61-5-9.sslip.io
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
