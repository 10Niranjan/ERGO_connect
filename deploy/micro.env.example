# Copy to .env on the VM (never commit .env). Generate secrets with:  openssl rand -base64 36
# Public hostname, no scheme. Free, no signup: dashed-IP.sslip.io, e.g. 130-61-5-9.sslip.io for IP 130.61.5.9.
DOMAIN=130-61-5-9.sslip.io
# Neon DIRECT (non-pooled) connection, as a JDBC URL, with sslmode=require. Username/password are Neon's, not a URL part.
DB_URL=jdbc:postgresql://ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
# GitHub owner of the GHCR images (lowercase)
IMAGE_OWNER=varadyadav02
