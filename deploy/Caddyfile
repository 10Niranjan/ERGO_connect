# Automatic HTTPS (Let's Encrypt) for {$DOMAIN}. Ports 80 and 443 must be open to the internet.
# nginx in the frontend container serves the SPA and proxies /api to the backend (same origin, no CORS surprises).
# Caddy sends X-Forwarded-Proto: https, which nginx passes on to the backend.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 55MB
	}
	reverse_proxy frontend:8080
}
