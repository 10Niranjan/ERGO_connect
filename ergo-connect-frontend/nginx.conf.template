# Same-origin in prod, same reason as vite.config.ts's dev proxy: keeps the backend's CORS
# allow-list strict and keeps the backend URL out of the bundle.
#
# TLS ends at the Azure ingress in front of this container, which forwards its own
# X-Forwarded-Proto: https. $scheme here is always "http" (this server only speaks plain
# HTTP), so passing it straight through would overwrite the ingress's value and make the
# prod backend's RemoteIpValve conclude every request is insecure - killing the 8c HSTS
# header and any https:// redirect/absolute URL it builds. Keep the upstream value; only
# fall back to $scheme if there's no ingress hop to supply one (security-reviewer H2).
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    # Compression (Phase 8o). The dashboard and list endpoints return up to a megabyte of JSON and the bundle is the
    # other big download; text compresses 10-20x, which is most of the page-load time on a real connection.
    # BREACH (a secret and attacker-chosen text in one compressed response): API calls carry a bearer header another site
    # cannot make a browser send, and the one cookie-authenticated call, /api/auth/refresh (SameSite=Strict, Path=/api/auth),
    # echoes nothing from its request next to the token it returns. The variant where an outsider plants text that this app
    # later returns beside data they cannot see needs a network observer and thousands of audited writes; judged impractical.
    # Revisit if a response is ever added that reflects request input next to a token or code.
    # gzip_proxied any: without it nginx skips responses to requests that carry a Via header, as proxies in front add.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css text/plain image/svg+xml;

    location /api {
        # Matches the app's own 50MB upload cap (UploadController); off so the backend's
        # rate limiter sees the request before nginx finishes buffering the whole body to
        # disk (security-reviewer M1).
        client_max_body_size 51m;
        proxy_request_buffering off;
        # ${BACKEND_UPSTREAM} is envsubst'd at container start (this file is a template -
        # see Dockerfile) because the correct upstream differs by host: plain Docker (local
        # smoke test) reaches the backend container directly on its own port (backend:8080),
        # but Azure Container Apps fronts every app's ingress on port 80/443 regardless of
        # its containers' actual listening port - calling another app in the same
        # environment is always "http://<app-name>", never ":8080" (Phase 8k). The Dockerfile
        # ENV default keeps local/docker-compose.yml working unchanged.
        proxy_pass ${BACKEND_UPSTREAM};
        # Container Apps' Envoy routes by Host, so there the upstream's own name must go out ($proxy_host; the
        # public host would land on this app again) and Spring then sees a cross-origin call, which the CORS
        # allow-list permits. Plain Docker keeps $host (same-origin, no CORS). Envoy also answers HTTP/1.0 - nginx's
        # upstream default - with 426. Both unverified until a real deploy (security-reviewer M1).
        proxy_http_version 1.1;
        proxy_set_header Host ${BACKEND_HOST_HEADER};
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
    }

    location / {
        # Spring only sets these on /api responses; the SPA shell needs them too so it
        # can't be framed or sniffed (security-reviewer L1).
        # CSP (8p F1): everything from this origin only. 'unsafe-inline' styles: MUI/emotion injects <style> tags at
        # runtime. blob: images: the document preview (DocumentDetailPage). No data: (vite.config.ts inlines nothing).
        # connect-src 'self' holds because the app calls /api on this origin; a cross-origin VITE_API_BASE_URL needs it added.
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        try_files $uri /index.html;
    }
}
